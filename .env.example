# 이 파일을 복사해 .env 를 만들고 값을 채운다. (.env 는 커밋하지 않는다)

# 서버
PORT=3000
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# 토큰 서명 키. 32자 이상 무작위 문자열
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# 화면을 다른 주소에서 띄울 때만 (쉼표로 구분). 개발 중에는 비워둔다
CORS_ORIGINS=
SHUTDOWN_TIMEOUT_MS=10000

# Valkey(Redis 호환)
REDIS_URL=redis://localhost:6379

# PostgreSQL — docker-compose.yml 이 아래 세 값으로 DB를 만든다
POSTGRES_USER=lounge
POSTGRES_PASSWORD=
POSTGRES_DB=lounge
# 위 값과 맞춘다: postgres://사용자:비밀번호@localhost:5432/DB이름
DATABASE_URL=postgres://lounge:비밀번호@localhost:5432/lounge

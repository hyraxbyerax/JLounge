# 내 컴퓨터에서 바로 켤 수 있는 기본값이 들어 있다. npm install 때 .env 가 없으면 이 파일을 복사해 자동으로 만든다.
# (.env 는 커밋하지 않는다. 아래 비밀번호·키는 각자 컴퓨터 안에서만 쓰는 개발용이라 공개돼도 괜찮다)
# AWS 등 운영에서는 이 값을 쓰지 않고 진짜 값을 따로 넣는다. 서버는 운영 모드에서 개발용 AUTH_SECRET 이면 켜지지 않는다.

# 서버
PORT=3000
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# 로그인 토큰 서명 키 (32자 이상). 아래는 개발용 — 운영에서는 무작위 값으로 바꾼다
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=local-dev-only-auth-secret-change-in-production
# 화면을 다른 주소에서 띄울 때만 (쉼표로 구분). 개발 중에는 비워둔다
CORS_ORIGINS=
SHUTDOWN_TIMEOUT_MS=10000
# 로드밸런서(AWS ALB, 로컬 다중 서버의 nginx) 뒤에서 돌 때만 true. 게스트 비밀번호 잠금을 접속 주소 기준으로 하기 위해
TRUST_PROXY=false
# 화면 빌드 폴더. 주면 서버가 화면까지 같은 주소로 내보낸다 (Docker 이미지에는 이미 들어 있음). 개발 중에는 비워둔다
WEB_DIST_DIR=
# 캠퍼스 플래너 화면 아래 "응답 서버: ..." 에 보일 이름 (서버 여러 대 시연용). 비우면 컴퓨터 이름
INSTANCE_NAME=

# 유튜브 곡 검색 (YouTube Data API v3 키). 비워두면 예시 곡만 검색된다
#   발급: Google Cloud Console → API 및 서비스 → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=
# 같은 검색어 결과를 저장해 두는 시간(초). 기본 6시간
SEARCH_CACHE_TTL_SEC=21600

# Valkey(Redis 호환)
# 컴퓨터 쪽 포트 (docker-compose.yml)
VALKEY_PORT=6379
REDIS_URL=redis://localhost:6379

# PostgreSQL — docker-compose.yml 이 아래 세 값으로 DB를 만든다
POSTGRES_USER=lounge
POSTGRES_PASSWORD=lounge-local
POSTGRES_DB=lounge
# Windows가 5432 근처 포트를 예약하는 경우가 있어 15432를 쓴다
POSTGRES_PORT=15432
# 위 값과 맞춘다: postgres://사용자:비밀번호@localhost:15432/DB이름
DATABASE_URL=postgres://lounge:lounge-local@localhost:15432/lounge
